{
  "name": "twin-scene",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "vite --host 127.0.0.1 --mode cb --strictPort",
    "dev:wd": "vite --host --mode wd",
    "dev:cb": "vite --host --mode cb",
    "dev:test": "vite --host --mode test",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:prod": "run-p type-check \"build-only:prod\"",
    "build:test": "run-p type-check \"build-only:test\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:wd": "vite build --mode wd",
    "build-only:cb": "vite build --mode cb",
    "build-only:prod": "vite build --mode production",
    "build-only:test": "vite build --mode test",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "animate.css": "^4.1.1",
    "axios": "^1.3.4",
    "axios-mapper": "0.5.4",
    "buffer": "^6.0.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.3",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.2",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "geotiff": "^2.1.4-beta.0",
    "js-cookie": "^3.0.5",
    "jsencrypt": "^3.3.1",
    "lodash": "^4.17.21",
    "marked": "^18.1.0",
    "marzipano": "^0.10.2",
    "mitt": "^3.0.1",
    "mqtt": "^5.13.1",
    "node-fetch": "^3.3.2",
    "nprogress": "^0.2.0",
    "pg": "^8.16.3",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.4.1",
    "sm-crypto": "^0.4.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.0",
    "vue3-carousel-3d": "^1.0.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@gradio/client": "^1.14.2",
    "@rollup/plugin-inject": "^5.0.5",
    "@tsconfig/node22": "^22.0.1",
    "@turf/turf": "^6.5.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/nprogress": "^0.2.3",
    "@types/vue3-carousel-3d": "^1.0.3",
    "@types/wellknown": "^0.5.8",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "less": "^4.3.0",
    "less-loader": "^12.2.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8",
    "wellknown": "^0.5.0"
  }
}
